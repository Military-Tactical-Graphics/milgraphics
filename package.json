{
  "name": "milgraphics",
  "version": "1.2.1",
  "description": "MilGraphics is a library for drawing military graphics",
  "main": "dist/milgraphics.js",
  "directories": {
    "doc": "docs",
    "example": "examples"
  },
  "scripts": {
    "build": "webpack --config webpack.production.js --progress --profile",
    "build-pure": "webpack --config webpack.production-pure.js --progress --profile",
    "start": "webpack serve --config webpack.development.js",
    "prepublish": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/spatialillusions/milgraphics"
  },
  "author": "Måns Beckman (http://www.spatialillusions.com), Ondřej Podolský",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/spatialillusions/milgraphics/issues"
  },
  "homepage": "https://github.com/spatialillusions/milgraphics",
  "devDependencies": {
    "@babel/cli": "^7.27.0",
    "@babel/core": "^7.26.10",
    "@babel/eslint-parser": "^7.27.0",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/plugin-transform-destructuring": "^7.25.9",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "babel-loader": "^9.2.1",
    "eslint": "^9.24.0",
    "html-webpack-plugin": "^5.6.3",
    "milsymbol": "3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "source-map-loader": "^5.0.0",
    "webpack": "^5.99.5",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.1"
  },
  "peerDependencies": {
    "@types/react": "^18.3.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "file-loader": "^6.2.0",
    "geodesy": "^2.4.0",
    "ol": "^9.2.4",
    "requirejs": "^2.3.7"
  }
